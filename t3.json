{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Setup",
      "command": "node scripts/t3-setup.mjs",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Dev",
      "command": "npm run dev",
      "icon": "play",
      "previewUrl": "http://127.0.0.1:3000",
      "autoOpenPreview": true
    },
    {
      "name": "Test",
      "command": "npm test",
      "icon": "test"
    },
    {
      "name": "Typecheck",
      "command": "npm run typecheck",
      "icon": "lint"
    },
    {
      "name": "Build",
      "command": "npm run build",
      "icon": "build"
    }
  ]
}
